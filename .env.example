REALTIME_VOICE=shimmer
AZURE_OPENAI_ENDPOINT=https://es-aida-ai-proxy.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-realtime-1.5
AZURE_OPENAI_API_KEY=replace-me

FIREBASE_DATABASE_URL=https://replace-me-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}
AZURE_SQL_CONNECTION_STRING=Server=tcp:replace-me.database.windows.net,1433;Database=replace-me;UID=replace-me;PWD=replace-me;Encrypt=yes;TrustServerCertificate=no;

WS_BASIC_USERNAME=replace-me
WS_BASIC_PASSWORD=replace-me
# Producción debe mantenerlo en true. Docker Compose local lo desactiva explícitamente.
WS_BASIC_AUTH_REQUIRED=true

# Segundos de espera inicial antes de pasar a observación del robot.
DRAWING_START_TIMEOUT_SECONDS=60
DRAWING_COMPLETE_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
